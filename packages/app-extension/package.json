{
  "name": "@quasar/quasar-app-extension-qiconpicker",
  "version": "3.0.0-beta.4",
  "description": "A Quasar App Extension for @quasar/quasar-ui-qiconpicker",
  "keywords": [
    "app",
    "app extension",
    "extension",
    "icon picker",
    "quasar",
    "quasarframework"
  ],
  "homepage": "https://github.com/quasarframework/quasar-ui-qiconpicker",
  "bugs": "https://github.com/quasarframework/quasar-ui-qiconpicker/issues",
  "license": "MIT",
  "author": "Jeff Galbraith <jeff@quasar.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasarframework/quasar-ui-qiconpicker.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hawkeye64"
  },
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#q-app": "@quasar/app-vite"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
