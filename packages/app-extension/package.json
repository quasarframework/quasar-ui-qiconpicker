    "prepack": "pnpm build",
    "release": "pnpm publish --tag beta"
  },
  "dependencies": {
    "@quasar/quasar-ui-qiconpicker": "workspace:^"
  },
  "devDependencies": {
    "@quasar/app-vite": "3.0.0-beta.44",
    "typescript": "~6.0.3",
    "vue-router": "^5.1.0"
  },
  "peerDependencies": {
    "@quasar/app-vite": ">=3.0.0-beta.44"
  },
  "engines": {
