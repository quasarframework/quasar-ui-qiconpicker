{
  "name": "@quasar/quasar-ui-qiconpicker",
  "version": "3.0.0-beta.0",
  "description": "QIconPicker - Quasar component",
  "keywords": [
    "icon",
    "iconpicker",
    "picker",
    "quasar",
    "quasarframework"
  ],
  "homepage": "https://github.com/quasarframework/quasar-ui-qiconpicker",
  "bugs": "https://github.com/quasarframework/quasar-ui-qiconpicker/issues",
  "license": "MIT",
  "author": "Jeff Galbraith <jeff@quasar.dev>",
  "contributors": [
    {
      "name": "Christian Behon",
      "email": "christian.behon@knusperleicht.at",
      "url": "https://knusperleicht.at"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasarframework/quasar-ui-qiconpicker.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hawkeye64"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./index.min.css": {
      "default": "./dist/index.min.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./index.rtl.min.css": {
      "default": "./dist/index.rtl.min.css"
    },
    "./index.rtl.css": {
      "default": "./dist/index.rtl.css"
    },
    "./dist/api/QIconPicker.json": {
      "default": "./dist/api/QIconPicker.json"
    },
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint src build types",
    "dev:umd": "pnpm build && node build/script.open-umd.js",
    "build": "node build/index.js && node build/script.types.js",
    "build:js": "node build/script.javascript.js",
    "build:css": "node build/script.css.js",
    "build:api": "node build/build.api.js && node build/script.types.js",
    "typecheck": "pnpm build:api && tsc -p test-d/tsconfig.json --noEmit --pretty false",
    "test:types": "pnpm build && pnpm typecheck",
    "release": "pnpm publish --tag beta",
    "icons:mdi-v6": "node build/icons/build.mdi-v6.js",
    "icons:mdi-v7": "node build/icons/build.mdi-v7.js",
    "icons:ionicons-v6": "node build/icons/build.ionicons-v6.js",
    "icons:ionicons-v7": "node build/icons/build.ionicons-v7.js",
    "icons:eva": "node build/icons/build.eva.js",
    "icons:themify": "node build/icons/build.themify.js",
    "icons:bootstrap-icons": "node build/icons/build.bootstrap-icons.js",
    "icons:fontawesome": "node build/icons/build.fontawesome-v5.js",
    "icons:fontawesome-v6": "node build/icons/build.fontawesome-v6.js",
    "icons:material-symbols": "node build/icons/build.material-symbols.js",
    "icons:material": "node build/icons/build.google.material-icons.js",
    "icons:all": "node build/icons/build.all.js"
  },
  "devDependencies": {
    "@quasar/extras": "^1.18.0",
    "@types/node": "^25.9.1",
    "autoprefixer": "^10.4.21",
    "cross-fetch": "^3.1.6",
    "cssnano": "^7.1.9",
    "fs-extra": "^11.3.2",
    "kolorist": "^1.8.0",
    "open": "^10.2.0",
    "postcss": "^8.5.6",
    "quasar": "^2.19.3",
    "quasar-json-api": "2.0.0-alpha.5",
    "rimraf": "^6.1.3",
    "rolldown": "^1.0.0",
    "rtlcss": "^4.3.0",
    "sass-embedded": "^1.99.0",
    "table": "^6.9.0",
    "typescript": "~5.9.3",
    "uglify-js": "^3.19.3",
    "vue": "^3.5.34",
    "zlib": "^1.0.5"
  },
  "browserslist": [
    "last 4 Chrome versions",
    "last 4 Firefox versions",
    "last 2 Edge versions",
    "last 4 Safari versions",
    "last 4 Android versions",
    "last 4 ChromeAndroid versions",
    "last 4 FirefoxAndroid versions",
    "last 4 iOS versions"
  ],
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.1.0"
  },
  "vetur": {
    "tags": "dist/vetur/tags.json",
    "attributes": "dist/vetur/attributes.json"
  }
}
